":"1ff8930b-09e9-45ce-993d-1226c743588b","sessionId":"2d9a05b1-12c2-4579-84bc-5fcb3acafe98","displayValue":"Matilde Lalin","answers":["Matilde Lalin"]},"ed161947-576f-4a6a-a4e1-5d22ce5a1203":{"id":"ed161947-576f-4a6a-a4e1-5d22ce5a1203","sessionId":"2d9a05b1-12c2-4579-84bc-5fcb3acafe98","displayValue":"3 - Number Theory","answers":["3 - Number Theory"]}},"registrantInformation":"","displayPriority":0,"showOnAgenda":true,"isOpenForAttendeeHub":true,"featuredSession":false,"speakerIds":{"9dbffde6-a3d2-4537-8853-a4e5921e0e5f":{"speakerId":"9dbffde6-a3d2-4537-8853-a4e5921e0e5f","speakerCategoryId":"ab3cd2dc-d1f9-4200-a5a7-26b170cec2fb","sessionId":"2d9a05b1-12c2-4579-84bc-5fcb3acafe98","sessionSpeakerOrder":0}},"documents":{},"createdDate":"2026-05-16T11:34:17.600Z","restrictSessionVisibility":true},"10f4dc2a-a370-4f8d-9942-1684197efe27":{"code":"SCEmilyCrawfordDasSESSION","description":"This talk is about an optimal stock selling rule with trading constraints. The goal is determining the time to sell the equity to maximize a discounted reward function. A geometric Brownian motion model represents the underlying stock price movement, and the trading permission process is given in terms of a two-state Markov chain. The optimal policy is determined by a threshold level obtained from solving an associated set of Hamilton-Jacobi-Bellman (HJB) equations (quasi-variational inequalities), from which a closed-form solution is obtained. A verification theorem is provided. Numerical experiments are also included to demonstrate the dependence of the optimal policy and value functions on input parameters.","id":"10f4dc2a-a370-4f8d-9942-1684197efe27","capacityId":"10f4dc2a-a370-4f8d-9942-1684197efe27","name":"An Optimal Stock Selling Rule with Constraints","status":2,"type":"Session","defaultFeeId":"00000000-0000-0000-0000-000000000000","fees":{},"closedReasonType":"NotClosed","isOpenForRegistration":false,"presentationType":"","categoryId":"dd348cad-9fa9-4bfb-8f6b-0d76eda0f5fe","wai