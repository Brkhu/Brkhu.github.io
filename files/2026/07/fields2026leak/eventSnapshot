a":true,"isOpenForAttendeeHub":true,"featuredSession":false,"speakerIds":{"eff4c0e1-5551-4226-9def-e405a74a2792":{"speakerId":"eff4c0e1-5551-4226-9def-e405a74a2792","speakerCategoryId":"9885dda8-db49-49b2-ba26-ef4b3da8f7cf","sessionId":"3b86e43b-3cfd-4a92-9fad-ad31a00116ca","sessionSpeakerOrder":1}},"documents":{},"createdDate":"2025-04-11T14:49:56.810Z","restrictSessionVisibility":true},"f8e1fd47-906e-44b3-9fa7-a2b0f6e55701":{"code":"SCRashiLuniaSESSION","description":"In 2008, Soundararajan introduced the resonance method and showed the existence of a normalized Hecke eigenform $f$ of weight $k$ and level one such that $L(s, f )$ takes large values at $s = 1/2$ for sufficiently large $k \\equiv 0 \\pmod{4}$. In this talk, we will discuss a recent work with Sanoli Gun, where we study how often $L(s, f )$ attains such large values at $s = 1/2$. We further investigate this question for $L$-functions attached to quadratic twists of $f$. Finally we give applications of our results to the theory of half-integer weight modular forms.","id":"f8e1fd47-906e-44b3-9fa7-a2b0f6e55701","capacityId":"f8e1fd47-906e-44b3-9fa7-a2b0f6e55701","name":"XXX CANCELLED Extreme Values of L-Functions of Newforms","status":2,"type":"Session","defaultFeeId":"00000000-0000-0000-0000-000000000000","fees":{},"closedReasonType":"NotClosed","isOpenForRegistration":false,"presentationType":"","categoryId":"dd348cad-9fa9-4bfb-8f6b-0d76eda0f5fe","capacity":346,"waitlistCapacityId":"f8e1fd47-906e-44b3-9fa7-a2b0f6e55701_waitlist","dataTagCode":"","startTime":"2026-07-29T17:10:00.000Z","endTime":"2026-07-29T17:30:00.000Z","locationId":"c7fdfa90-a4e4-44bd-ad39-4eb44fb769b5","locationName":"115-A","locationCode":"115-A","isIncludedSession":false,"isWaitlistEnabled":false,"registeredCount":0,"associatedWithAdmissionItems":[],"availableToAdmissionItems":[],"associatedRegistrationTypes":[],"sessionCustomFieldValues":{"1ff8930b-09e9-45ce-993d-1226c743588b":{"id":"1ff8930b-09e9-45ce-993d-1226c743588b","sessionI