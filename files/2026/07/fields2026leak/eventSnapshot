],\"data\":{}},{\"key\":\"68p7e\",\"text\":\"Recent advances in AI technologies threaten important values held in our community. Rooted in a joint conviction that as mathematicians, we have a responsibility to ensure the continued flourishing of our discipline, following a conference on Mechanization and Mathematical Research at the Lorentz Center at Leiden University, 17 authors began drafting recommendations on the future relations between the mathematical community and the new technology. I will explain how the resulting Leiden Declaration on Artificial Intelligence and Mathematics developed and share our perspective on the steps ahead for the community.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"cudes\",\"text\":\"Q & A\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":5,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"dftpf\",\"text\":\"Mark Wilson, Q & A Chair, Smith College\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":11,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"chvl5\",\"text\":\"Jarod Alper, University of Washington and Google Deepmind\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":11,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"8bke2\",\"text\":\"Michael Harris, Institut de Mathématiques de Jussieu\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":14,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"4kmr4\",\"text\":\"Bryna Kra, Northwestern University \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":9,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"b66d7\",\"text\":\"Moritz Schubotz, Leibniz Institute for Information Infrastructure \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":15,\"style\":