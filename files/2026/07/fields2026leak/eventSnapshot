            "6116f7bf-f3cf-4a44-8a9f-88efe3ff5d3d": {
                "id": "6116f7bf-f3cf-4a44-8a9f-88efe3ff5d3d",
                "categoryId": "9572a44e-0bbe-478a-9fe8-4e3e08eb598e",
