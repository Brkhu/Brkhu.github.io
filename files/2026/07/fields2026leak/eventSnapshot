d":false,"registeredCount":0,"associatedWithAdmissionItems":[],"availableToAdmissionItems":[],"associatedRegistrationTypes":[],"sessionCustomFieldValues":{},"registrantInformation":"","displayPriority":0,"showOnAgenda":false,"isOpenForAttendeeHub":false,"featuredSession":false,"speakerIds":{"f8f5fa42-4309-4064-8901-bb61c18c9add":{"speakerId":"f8f5fa42-4309-4064-8901-bb61c18c9add","speakerCategoryId":"9885dda8-db49-49b2-ba26-ef4b3da8f7cf","sessionId":"61f9eef7-08d8-4fc5-be37-bac54d1c30e7","sessionSpeakerOrder":1}},"documents":{},"createdDate":"2026-06-29T16:30:15.957Z","restrictSessionVisibility":false},"8254b69d-3641-4acb-966c-8a8f62ad6f12":{"code":"WojciechDe RoeckSession","description":"<div class=\"ag87-crtemvc-hsbk\">Anderson localization of a single quantum particle has been a topic in physics and mathematics since the seminal work of P. Anderson in 1958. In the last decades, the focus has shifted however to interacting particles. It was conjectured that some aspects of Anderson localization survive in macroscopic systems in the presence of interactions. In particular it is expected that the conductivity of strongly disordered quantum systems identically vanishes.  In recent work with Lydia Giacomin, Francois Huveneers and Oskar Prosniak, we prove that this is indeed the case for one-dimensional systems, i.e. for chains.</div>","id":"8254b69d-3641-4acb-966c-8a8f62ad6f12","capacityId":"8254b69d-3641-4acb-966c-8a8f62ad6f12","name":"Localization for Strongly Disordered Interacting Quantum Chains","status":2,"type":"Session","defaultFeeId":"00000000-0000-0000-0000-000000000000","fees":{},"closedReasonType":"NotClosed","isOpenForRegistration":false,"presentationType":"","categoryId":"7ac6a87e-8daa-4742-9215-4437219ac29a","capacity":523,"waitlistCapacityId":"8254b69d-3641-4acb-966c-8a8f62ad6f12_waitlist","dataTagCode":"","startTime":"2026-07-28T20:00:00.000Z","endTime":"2026-07-28T20:45:00.000Z","locationId":"bc81cad2-8b75-45cb-9355-a764c88805b2","locationName":"120-AB","locationCode":"120-AB","isIncludedSession":false,"isWaitlistEnabled":false,"registeredCount":13,"associatedWithAdmissionItems":[],"availableToAdmissionItems":[],"associatedRegistrationTypes":[],"sessionCustomFieldValues":{"1ff8930b-09e9-45ce-993d-1226c743588b":{"id":"1ff8930b-09e9-45ce-993d-1226c743588b","sessionId":"8254b69d-3641-4acb-966c-8a8f62ad6f12","displayValue":"Wojciech De Roeck","answers":["Wojciech De Roeck"]},"ed161947-576f-4a6a-a4e1-5d22ce5a1203":{"id":"ed161947-576f-4a6a-a4e1-5d22ce5a1203","sessionId":"8254b69d-3641-4acb-966c-8a8f62ad6f12","displayValue":"11 - Mathematical Physics","answers":["11 - Mathematical Physics"]}},"richTextDescription":"Anderson localization of a single quantum particle has been a topic in physics and mathematics since the seminal work of P. Anderson in 1958. In the last decades, the focus has shifted however to interacting particles. It was conjectured that some aspects of Anderson localization survive in macroscopic systems in the presence of interactions. In particular it is expected that the conductivity of strongly disordered quantum systems identically vanishes.  In recent work with Lydia Giacomin, Francois Huveneers and Oskar Prosniak, we prove that this is indeed the case for one-dimensional systems, i.e. for chains.","plainTextDescription":"Anderson localization of a single quantum particle has been a topic in physics and mathematics since the seminal work of P. Anderson in 1958. In the last decades, the focus has shifted however to interacting particles. It was conjectured that some aspects of Anderson localization survive in macroscopic systems in the presence of interactions. In particular it is expected that the conductivity of strongly disordered quantum systems identically vanishes.  In recent work with Lydia Giacomin, Francois Huveneers and Oskar Prosniak, we prove that this is indeed the case for one-dimensional systems, i.e. for chains.","registrantInformation":"","displayPriority":0,"showOnAgenda":true,