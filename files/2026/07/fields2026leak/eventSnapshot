bution-free regime. The results presented in this talk are based on joint work with Emmanuel Candes, Aaditya Ramdas, Ryan Tibshirani, Jake Soloff, Rebecca Willett, Byol Kim, and Yuetian Luo.","registrantInformation":"","displayPriority":0,"showOnAgenda":true,"isOpenForAttendeeHub":true,"featuredSession":false,"speakerIds":{"138a9737-716b-4ee3-a0b6-b520557cd403":{"speakerId":"138a9737-716b-4ee3-a0b6-b520557cd403","speakerCategoryId":"45ab9016-e39c-4327-8bdb-50c0e5f04916","sessionId":"624f9e70-de8d-4a0e-b2f1-51b00b5bbcf1","sessionSpeakerOrder":1}},"documents":{},"createdDate":"2025-04-11T14:49:56.810Z","restrictSessionVisibility":true},"453e5103-4817-408a-984b-ad3b6087350e":{"code":"BenoitPausaderSession","description":"<div class=\"ag87-crtemvc-hsbk\">The Vlasov-Poisson system is the simplest non-collisional kinetic model. It describes the evolution of a distribution of particles influenced only by a force induced by their mean-field. We survey recent advances in the stability of stationary states and the asymptotic behavior of solutions for various variants of this system.</div>","id":"453e5103-4817-408a-984b-ad3b6087350e","capacityId":"453e5103-4817-408a-984b-ad3b6087350e","name":"Stability Problems in Collisionless Kinetic Theory","status":2,"type":"Session","defaultFeeId":"00000000-0000-0000-0000-000000000000","fees":{},"closedReasonType":"NotClosed","isOpenForRegistration":false,"presentationType":"","categoryId":"7ac6a87e-8daa-4742-9215-4437219ac29a","capacity":523,"waitlistCapacityId":"453e5103-4817-408a-984b-ad3b6087350e_waitlist","dataTagCode":"","startTime":"2026-07-24T20:00:00.000Z","endTime":"2026-07-24T20:45:00.000Z","locationId":"bc81cad2-8b75-45cb-9355-a764c88805b2","locationName":"120-AB","locationCode":"120-AB","isIncludedSession":false,"isWaitlistEnabled":false,"registeredCount":27,"associatedWithAdmissionItems":[],"availableToAdmissionItems":[],"associatedRegistrationTypes":[],"sessionCustomFieldValues":{"1ff8930b-09e9-45ce-993d-1226c743588b":{"id"