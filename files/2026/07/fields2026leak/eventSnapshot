 dimension.","registrantInformation":"","displayPriority":0,"showOnAgenda":true,"isOpenForAttendeeHub":true,"featuredSession":false,"speakerIds":{"2bd8605c-4737-42d8-8797-75c29795f1d9":{"speakerId":"2bd8605c-4737-42d8-8797-75c29795f1d9","speakerCategoryId":"cee6986f-c8ec-441f-94a0-81cee775f986","sessionId":"31f2f230-3439-4f7e-981a-91dce114e7a0","sessionSpeakerOrder":1},"f0f5e34d-e130-41ac-9c2b-b1979354f0c8":{"speakerId":"f0f5e34d-e130-41ac-9c2b-b1979354f0c8","speakerCategoryId":"cee6986f-c8ec-441f-94a0-81cee775f986","sessionId":"31f2f230-3439-4f7e-981a-91dce114e7a0","sessionSpeakerOrder":3},"971ba24e-4e84-4342-afc7-bd8e3b5b35f7":{"speakerId":"971ba24e-4e84-4342-afc7-bd8e3b5b35f7","speakerCategoryId":"cee6986f-c8ec-441f-94a0-81cee775f986","sessionId":"31f2f230-3439-4f7e-981a-91dce114e7a0","sessionSpeakerOrder":2}},"documents":{},"createdDate":"2025-04-11T14:49:56.810Z","restrictSessionVisibility":true},"d89549e0-fda0-431b-bb9f-8977a84a4a90":{"code":"SCAnilKhairnarSESSION","description":"We introduced the class of weakly generalized p.q.-Baer $*$-rings. It is proved that under some assumptions every weakly generalized p.q.-Baer $*$-ring  can be embedded in generalized p.q.-Baer $*$-ring.  We proved that a generalized p.q.-Baer $*$-rings has partial comparability. If a generalized p.q.-Baer $*$-ring satisfies the parallelogram law then it is proved that every pair of projections has an orthogonal decomposition. A separation theorem for generalized p.q.-Baer $*$-rings is obtained. As an application of spectral theory, it is proved that generalized p.q.-Baer $*$-rings have  a sheaf representation with injective sections.","id":"d89549e0-fda0-431b-bb9f-8977a84a4a90","capacityId":"d89549e0-fda0-431b-bb9f-8977a84a4a90","name":"On Generalized p.q.-Baer $*$-rings","status":2,"type":"Session","defaultFeeId":"00000000-0000-0000-0000-000000000000","fees":{},"closedReasonType":"NotClosed","isOpenForRegistration":false,"presentationType":"","categoryId":"dd348cad-9fa9-4bfb-8f6b-0d